<!-- Federated CFR Connect Protocol (FCP). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.nixort</groupId>
  <artifactId>libfcp</artifactId>
  <version>1.0.0-rc.1</version>
  <packaging>jar</packaging>

  <name>libfcp Java</name>
  <description>Java 17 and Kotlin JNI façades over the canonical Rust FCP protocol core.</description>
  <url>https://github.com/Nixort/libfcp</url>

  <licenses>
    <license>
      <name>GNU General Public License v3.0 only</name>
      <url>https://www.gnu.org/licenses/gpl-3.0-standalone.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>Nixort</id>
      <name>Nixort</name>
      <email>nixort@proton.me</email>
      <url>https://github.com/Nixort</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/Nixort/libfcp.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/Nixort/libfcp.git</developerConnection>
    <url>https://github.com/Nixort/libfcp</url>
    <tag>v${project.version}</tag>
  </scm>

  <distributionManagement>
    <repository>
      <id>central</id>
      <name>Maven Central Portal</name>
      <url>https://central.sonatype.com/api/v1/publisher</url>
    </repository>
  </distributionManagement>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <kotlin.version>2.4.10</kotlin.version>
    <fcp.ffi.abi.major>2</fcp.ffi.abi.major>
    <central-publishing-maven-plugin.version>0.9.0</central-publishing-maven-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>${kotlin.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <version>${central-publishing-maven-plugin.version}</version>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
          <autoPublish>false</autoPublish>
          <waitUntil>validated</waitUntil>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
